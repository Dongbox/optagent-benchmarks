.DS_Store

# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and build outputs
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Local logs and ad hoc scratch output
logs/
tmp/
*.log

# wheel
*.whl

# Keep versioned dashboard/presentation artifacts addable by default.
!presentation/
!presentation/results/
!presentation/aggregates/
