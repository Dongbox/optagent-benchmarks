.DS_Store

# Python bytecode and test caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments and build outputs
.venv/
venv/
env/
*.egg-info/
build/
dist/

# Local benchmark data cache. Keep the placeholder tracked.
data-cache/*
!data-cache/.gitignore

# Local logs and ad hoc scratch output
logs/
tmp/
*.log

# Keep versioned dashboard/result artifacts addable by default.
!results/
!aggregates/
